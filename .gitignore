# Python bytecode cache (arc_fit.py)
__pycache__/
*.pyc

# Task's fingerprint cache
.task/

# Autosave/crash-recovery file written by the app into its working directory
crashfile.temp

# Lock files the app writes beside an open document (~<name>.lck). Runtime
# state naming a host and a process id, so it belongs to whoever has the file
# open, never to the repository -- and opening a test fixture deletes any that
# was committed.
~*.lck
mac/build/

# Intro previews (mac/Tools/render-intro.sh)
mac/Tools/intro-preview/
